# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Used by server-side admin operations (e.g. webhook user sync)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# MCP Server URL (point to your deployed packages/mcp instance)
NEXT_PUBLIC_MCP_SERVER_URL=http://localhost:3000

# Internal MCP server URL (used by Next.js API routes — can be the same as above)
MCP_SERVER_URL=http://localhost:3000

# OpenRouter (forwarded to the MCP server for AI-powered features)
OPENROUTER_API_KEY=your_openrouter_key_here
